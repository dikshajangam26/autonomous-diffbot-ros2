<?xml version="1.0"?>
<!-- Small textured warehouse room (8 m x 8 m, ceiling at 2 m).
     Stereo cameras find depth by matching TEXTURE between the left and right image, so every
     surface uses a textured Gazebo material (plain-colour surfaces would give no points).
     The robot starts at (0, 0) facing +x. Objects are kept >1.5 m away from the robot's circle. -->
<sdf version="1.6">
  <world name="warehouse">
    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>8.2 8.2</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>8.2 8.2</size></plane></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_n">
      <static>true</static>
      <pose>0 4.0 1.0 0 0 0</pose>
      <link name="link">
      <collision name="c"><geometry><box><size>8.2 0.2 2.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>8.2 0.2 2.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material>
        </visual>
      </link>
    </model>
    <model name="wall_s">
      <static>true</static>
      <pose>0 -4.0 1.0 0 0 0</pose>
      <link name="link">
      <collision name="c"><geometry><box><size>8.2 0.2 2.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>8.2 0.2 2.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material>
        </visual>
      </link>
    </model>
    <model name="wall_e">
      <static>true</static>
      <pose>4.0 0 1.0 0 0 0</pose>
      <link name="link">
      <collision name="c"><geometry><box><size>0.2 8.2 2.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 8.2 2.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material>
        </visual>
      </link>
    </model>
    <model name="wall_w">
      <static>true</static>
      <pose>-4.0 0 1.0 0 0 0</pose>
      <link name="link">
      <collision name="c"><geometry><box><size>0.2 8.2 2.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 8.2 2.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material>
        </visual>
      </link>
    </model>
    <model name="ceiling">
      <static>true</static>
      <pose>0 0 2.05 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>8.2 8.2 0.1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodPallet</name></script></material>
        </visual>
      </link>
    </model>
    <model name="shelf_1">
      <static>true</static>
      <pose>3.0 1.6 0.8 0 0 0</pose>
      <link name="link">
      <collision name="c"><geometry><box><size>0.5 1.6 1.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.5 1.6 1.6</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodPallet</name></script></material>
        </visual>
      </link>
    </model>
    <model name="shelf_2">
      <static>true</static>
      <pose>3.0 -1.6 0.8 0 0 0</pose>
      <link name="link">
      <collision name="c"><geometry><box><size>0.5 1.6 1.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.5 1.6 1.6</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodPallet</name></script></material>
        </visual>
      </link>
    </model>
    <model name="shelf_3">
      <static>true</static>
      <pose>-1.5 3.4 0.8 0 0 0</pose>
      <link name="link">
      <collision name="c"><geometry><box><size>1.6 0.5 1.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.6 0.5 1.6</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodPallet</name></script></material>
        </visual>
      </link>
    </model>
    <model name="box_1">
      <static>true</static>
      <pose>1.8 0.0 0.25 0 0 0</pose>
      <link name="link">
      <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/CardboardBox</name></script></material>
        </visual>
      </link>
    </model>
    <model name="box_2">
      <static>true</static>
      <pose>-2.0 1.8 0.4 0 0 0</pose>
      <link name="link">
      <collision name="c"><geometry><box><size>0.6 0.6 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.6 0.6 0.8</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/CardboardBox</name></script></material>
        </visual>
      </link>
    </model>
    <model name="box_3">
      <static>true</static>
      <pose>-1.8 -2.0 0.25 0 0 0</pose>
      <link name="link">
      <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/CardboardBox</name></script></material>
        </visual>
      </link>
    </model>
    <model name="box_4">
      <static>true</static>
      <pose>0.0 2.6 0.3 0 0 0</pose>
      <link name="link">
      <collision name="c"><geometry><box><size>0.8 0.4 0.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.8 0.4 0.6</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/CardboardBox</name></script></material>
        </visual>
      </link>
    </model>
    <model name="box_5">
      <static>true</static>
      <pose>0.8 -2.8 0.5 0 0 0</pose>
      <link name="link">
      <collision name="c"><geometry><box><size>0.4 0.4 1.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.4 0.4 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/CardboardBox</name></script></material>
        </visual>
      </link>
    </model>
    <model name="pallet_1">
      <static>true</static>
      <pose>-3.0 0.0 0.075 0 0 0</pose>
      <link name="link">
      <collision name="c"><geometry><box><size>1.2 0.8 0.15</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.2 0.8 0.15</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodPallet</name></script></material>
        </visual>
      </link>
    </model>
    <model name="pallet_2">
      <static>true</static>
      <pose>2.2 -3.0 0.075 0 0 0</pose>
      <link name="link">
      <collision name="c"><geometry><box><size>1.2 0.8 0.15</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.2 0.8 0.15</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodPallet</name></script></material>
        </visual>
      </link>
    </model>

    <!-- A person walking a loop in front of the robot's start area (animated, no collision).
         Uses Gazebo's built-in walk.dae animation, so no download is needed. -->
    <actor name="worker">
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walking">
        <filename>walk.dae</filename><scale>1.0</scale><interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop><delay_start>0.0</delay_start><auto_start>true</auto_start>
        <trajectory id="0" type="walking">
        <waypoint><time>0.00</time><pose>0.0 -1.3 1.0 0 0 0.000</pose></waypoint>
        <waypoint><time>3.67</time><pose>2.2 -1.3 1.0 0 0 1.571</pose></waypoint>
        <waypoint><time>4.33</time><pose>2.2 -0.9 1.0 0 0 3.142</pose></waypoint>
        <waypoint><time>8.00</time><pose>0.0 -0.9 1.0 0 0 -1.571</pose></waypoint>
        <waypoint><time>8.67</time><pose>0.0 -1.3 1.0 0 0 0.000</pose></waypoint>
        </trajectory>
      </script>
    </actor>
  </world>
</sdf>
