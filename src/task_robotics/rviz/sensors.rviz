Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: false
      Show Axes: false
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Size (m): 0.05
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 0; 0
    - Class: rviz_default_plugins/Image
      Name: Left camera
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /stereo/left/image_raw
    - Class: rviz_default_plugins/Odometry
      Name: Wheel odometry (red)
      Enabled: true
      Keep: 300
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom
      Covariance:
        Orientation:
          Value: false
        Position:
          Value: false
        Value: false
      Shape:
        Alpha: 1
        Axes Length: 0.1
        Axes Radius: 0.01
        Color: 255; 0; 0
        Head Length: 0.03
        Head Radius: 0.02
        Shaft Length: 0.08
        Shaft Radius: 0.01
        Value: Arrow
    - Class: rviz_default_plugins/Odometry
      Name: EKF (green)
      Enabled: true
      Keep: 300
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/filtered
      Covariance:
        Orientation:
          Value: false
        Position:
          Value: false
        Value: false
      Shape:
        Alpha: 1
        Axes Length: 0.1
        Axes Radius: 0.01
        Color: 0; 255; 0
        Head Length: 0.03
        Head Radius: 0.02
        Shaft Length: 0.08
        Shaft Radius: 0.01
        Value: Arrow
    - Class: rviz_default_plugins/PointCloud2
      Name: Stereo cloud FILTERED
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /stereo/points_filtered
      Size (m): 0.04
      Style: Flat Squares
      Color Transformer: RGB8
      Channel Name: rgb
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Stereo cloud RAW (heavy)
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /stereo/points2
      Size (m): 0.01
      Style: Points
      Color Transformer: RGB8
      Channel Name: rgb
      Use Fixed Frame: true
  Enabled: true
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5.0
      Focal Point:
        X: 1.5
        Y: 0
        Z: 0
      Pitch: 0.7
      Yaw: 3.14159
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Window Geometry:
  Displays:
    collapsed: false
  Left camera:
    collapsed: false